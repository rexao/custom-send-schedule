{
    "manifest_version": 3,
    "name": "Custom Send Schedule",
    "version": "1.1",
    "description": "Add customizable schedule send times to Gmail and Outlook (for now).",
    "permissions": [
        "storage"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://mail.google.com/*",
                "https://outlook.live.com/*",
                "https://outlook.office.com/*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "styles.css"
            ],
            "run_at": "document_idle"
        }
    ],
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },
    "action": {
        "default_title": "Custom Send Schedule Settings",
        "default_popup": "options.html"
    }
}